#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME}/.bun/bin:${HOME}/.local/bin:${HOME}/.deno/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

BUN_BIN="${BUN_BIN:-$(command -v bun || true)}"
if [[ -z "${BUN_BIN}" || ! -x "${BUN_BIN}" ]]; then
  for candidate in "${HOME}/.bun/bin/bun" "/opt/homebrew/bin/bun" "/usr/local/bin/bun"; do
    if [[ -x "${candidate}" ]]; then
      BUN_BIN="${candidate}"
      break
    fi
  done
fi

if [[ -z "${BUN_BIN}" || ! -x "${BUN_BIN}" ]]; then
  echo "Error: bun binary not found in PATH." >&2
  exit 1
fi

exec "${BUN_BIN}" run "${REPO_DIR}/src/index.ts" "$@"
